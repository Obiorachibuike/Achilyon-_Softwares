# Achilyon environment configuration
# Copy to `.env.local` and adjust. Every variable is optional — sensible defaults are built in.
# Only variables prefixed with VITE_ are exposed to the browser bundle, so never put secrets here.

# DexScreener public API base URL (no key required, CORS-enabled).
VITE_DEXSCREENER_API_BASE=https://api.dexscreener.com

# GoPlus Security public API base URL used by the contract analyzer (no key required).
VITE_GOPLUS_API_BASE=https://api.gopluslabs.io/api/v1

# Comma-separated search seeds used to build the market universe.
VITE_MARKET_QUERIES=SOL,WETH,USDC,USDT,BNB,PEPE,BONK,WIF,ARB,BRETT

# How often market data, the watchlist and alerts refresh (milliseconds, minimum 15000).
VITE_REFRESH_INTERVAL_MS=60000

# Starting balance (USD) for the paper-trading workspace.
VITE_PAPER_STARTING_BALANCE=10000
