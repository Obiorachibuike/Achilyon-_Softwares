# ─────────────────────────────────────────────────────────────────────────────
# Achilyon environment configuration
# Copy to `.env.local` (git-ignored) and adjust. Every variable is optional for
# local development; defaults are built in and validated on startup.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle — NEVER put
# secrets in them. Everything else stays on the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (browser) ─────────────────────────────────────────────────────────

# Demo mode (default: true). When on, all market data, trades and launches are
# simulated by the in-process demo engine and labelled "Demo Data" in the UI.
# Set to `false` to read live market data from DexScreener/GeckoTerminal.
NEXT_PUBLIC_DEMO_MODE=true

# Canonical site URL, used for metadata, OG tags, sitemap and robots.txt.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Network preselected in the launch wizard and network selector.
# One of: ethereum, base, solana, bsc, arbitrum, polygon, avalanche
NEXT_PUBLIC_DEFAULT_CHAIN=base

# Starting cash (USD) for each demo wallet.
NEXT_PUBLIC_DEMO_STARTING_BALANCE=10000

# ── Server only ──────────────────────────────────────────────────────────────

# HMAC secret for session cookies (≥ 32 chars). REQUIRED in production.
# Generate with: openssl rand -hex 32
# In development an ephemeral secret is generated (sessions reset on restart).
SESSION_SECRET=

# Comma-separated wallet addresses granted the `admin` role (moderation console).
ADMIN_ADDRESSES=

# Public market data APIs (no keys required). Override for proxies/mirrors.
DEXSCREENER_API_BASE=https://api.dexscreener.com
GECKOTERMINAL_API_BASE=https://api.geckoterminal.com/api/v2
GOPLUS_API_BASE=https://api.gopluslabs.io/api/v1

# Live mode: comma-separated search seeds used to build the market universe.
MARKET_QUERIES=SOL,WETH,USDC,PEPE,BONK,WIF,BRETT,AERO,ARB,DEGEN

# On-chain launchpad (optional). JSON map of chain → deployment, as printed by
# `npm run contracts:deploy`. On-chain launch/trade is enabled only for the
# chains listed. Addresses are public; this never contains keys.
#   {"ethereum":{"address":"0x…","evmChainId":11155111,"startBlock":123,"testnet":true,"explorerUrl":"https://sepolia.etherscan.io","dexName":"Uniswap V2"}}
NEXT_PUBLIC_LAUNCHPAD_DEPLOYMENTS=

# Optional JSON-RPC endpoints for server-side reads (live-mode balances and
# launchpad event logs). Without them viem falls back to public RPCs, which are
# rate limited. A testnet launchpad deployment requires its chain's RPC_URL_*.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_POLYGON=
RPC_URL_BSC=
RPC_URL_AVALANCHE=

# NOTE: contracts:deploy reads DEPLOYER_PRIVATE_KEY / RPC_URL from your shell
# only. Never put a private key in this file or in .env.local.
